# GEMINI_API_KEY: Optional/runtime key for Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="http://localhost:3000"

# WEBJAWS DATABASE CONFIGURATION (Supabase PostgreSQL)
# Option 1: Direct PostgreSQL Connection URI (Supabase Connection Pooling / Direct DB connection)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:your-db-password@db.your-supabase-ref.supabase.co:5432/postgres"

# Option 2: Supabase REST API credentials (used exclusively by backend server, NEVER exposed to client)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# WEBJAWS CUSTOM AUTH & SESSION SECURITY
# Cryptographic secret for signing session cookies and tokens (minimum 32 characters)
SESSION_SECRET="change-this-to-a-very-secure-random-secret-key-min-32-chars"

# SESSION_DURATION_HOURS: Session timeout in hours (default: 24)
SESSION_DURATION_HOURS="24"

# NODE_ENV: 'development' | 'production'
NODE_ENV="development"
PORT="3000"
