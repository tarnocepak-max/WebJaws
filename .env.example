# WebJaws server environment template. Never commit the real .env file.
NODE_ENV=production
PORT=3000
APP_URL=https://your-webjaws-domain.example

# PostgreSQL connection URI from Supabase Dashboard > Connect > Connection string.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@HOST:6543/postgres?sslmode=require

# Required by server-side Supabase integrations only. Never expose in browser code.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_REAL_SERVER_SECRET

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_HEX_SECRET
SESSION_DURATION_HOURS=24
